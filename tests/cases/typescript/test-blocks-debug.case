Debug mode highlights a test block from its callee through its title, so a table test's table is highlighted too, but never its callback.
== args
--debug
input/math.test.js
== file input/math.test.js
describe("math", () => {
  it("adds", () => {});
});
test.each([[1, 2]])("adds %i", (a, b) => {});
== stdout
«describe("math"», () => {
  it("adds", () => {});
});
«test.each([[1, 2]])("adds %i"», (a, b) => {});
== stderr
== exit 0
