`export declare` statements print with both prefixes.
`declare const enum` keeps its `const`.
== args
input/types.d.ts
== file input/types.d.ts
export declare function render(view: View): string;
export declare const version: string, build: number;
export declare class Store<T> {
  get(key: string): T;
}
declare const enum Flags { A, B }
export declare namespace Api {}
