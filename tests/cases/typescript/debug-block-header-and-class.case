Debug mode highlights every line of a `/** */` header comment, then an `export class` and its constructor, getter, and method, but not its field.
== args
--debug
input/full-feature.ts
== file input/full-feature.ts
/**
 * Service module with class members.
 */
export class Service {
  private data: number;
  constructor(initial: number) {
    this.data = initial;
  }
  get value(): number {
    return this.data;
  }
  process(input: number): number {
    return input * 2;
  }
}
