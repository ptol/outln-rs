In debug mode, a `'use client'` directive above the header comment stays plain, while every line of the `/** */` header comment after it and the declaration are highlighted.
== args
--debug
input/page.tsx
== file input/page.tsx
'use client';
/**
 * Client page.
 */
export const page = 1;
== stdout
