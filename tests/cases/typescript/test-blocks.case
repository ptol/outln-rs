Top-level `describe`, `it`, `test`, and `suite` calls with a string or template literal title are listed as test blocks, with `.only`, `.skip`, and `.each` forms.
A table test (`.each(table)` or `.each` with a tagged template table) prints its callee and title without the table.
Blocks nested inside a test block's callback are listed one level deeper (`nested-test-blocks.case` covers depth); calls with other names or with a title that isn't a literal aren't listed.
== args
input/parser.test.ts
== file input/parser.test.ts
import { describe, it, test } from "vitest";

describe("parser", () => {
  it("parses headings", () => {});
  describe("nested", () => {});
});
it.only('focused', () => {});
describe.skip(`skipped`, () => {});
test.each([1, 2])("adds %i", (value) => {});
test.each`
  a    | b
  ${1} | ${2}
`("sums $a and $b", ({ a, b }) => {});
describe.only.each([["x"]])("with %s", (name) => {});
suite("node:test suite", () => {});
describe(Parser.name, () => {});
test.each("not a table form");
expect("value").toBe("value");
beforeEach(() => {});
