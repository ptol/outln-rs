Debug mode highlights a method's and a getter's return type (`: number`) as part of their signatures.
== args
--debug
input/class-return-types.ts
== file input/class-return-types.ts
class Calculator {
  add(a: number, b: number): number {
    return a + b;
  }
  get result(): number {
    return 42;
  }
}
