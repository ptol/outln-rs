Debug mode highlights `import X = …` aliases through their name, plain and exported `namespace` and `module` blocks through their name, and `export module 'exported/module'` through its quoted name.
== args
--debug
input/import-namespace-module.ts
== file input/import-namespace-module.ts
import FS = require('node:fs');
import ReadFile = FS.readFileSync;

namespace PlainNamespace {
  export const enabled = true;
}

module PlainModule {
  export const mode = 'plain';
}

export namespace ExportedNamespace {
  export const ready = true;
}

export module 'exported/module' {}
