Debug mode highlights `import … = require(…)` aliases placed between `namespace`, `module`, and `export namespace` blocks, each through its name, never the `require(…)` or a block's body.
== args
--debug
input/combined.ts
== file input/combined.ts
import FS = require('fs');

namespace Utils {
  export const helper = () => {};
}

import Path = require('path');

module Config {
  export const setting = 'value';
}

export namespace PublicAPI {
  export const version = '1.0';
}
