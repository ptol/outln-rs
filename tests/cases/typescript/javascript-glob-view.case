The glob view lists `.js`, `.jsx`, and `.mjs` files with their line count and header, or a declaration summary of its first declarations without one, and skips the unsupported `delta.txt`.
== args
input/**/*
== file input/alpha.js
// Alpha summary
const alpha = 1;
== file input/bravo.jsx
/** Bravo summary */
export function Bravo() {
  return <div />;
}
== file input/charlie.mjs
export const charlie = 3;
== file input/delta.txt
plain text
