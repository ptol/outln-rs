Debug mode highlights the `//` header comment and each declaration through its signature: `export const version` without its value, `export function run(value: number)` without its body.
== args
--debug
input/sample.ts
== file input/sample.ts
// Service bootstrap.

export const version = 1;
export function run(value: number) {
  return value + 1;
}
