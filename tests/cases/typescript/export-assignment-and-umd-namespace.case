In a `.d.ts` file, `export = lib` and `export as namespace Lib` are each listed as written, after the `declare function` they export.
== args
input/legacy.d.ts
== file input/legacy.d.ts
declare function lib(): void;
export = lib;
export as namespace Lib;
== stdout
input/legacy.d.ts (3 lines)
[L1-L1] declare function lib(): void
[L2-L2] export = lib
[L3-L3] export as namespace Lib
== stderr
== exit 0
