Debug mode highlights both lines of a `//` header comment, an `export interface`, an `export class` with its `constructor(private config: Config)` and `start(): void` members, and a function's signature, never a body.
== args
--debug
input/service.ts
== file input/service.ts
// Main service module.
// Provides core functionality.

export interface Config {
  name: string;
}

export class Service {
  constructor(private config: Config) {}

  start(): void {
    console.log('starting');
  }
}

export function createService(config: Config): Service {
  return new Service(config);
}
