`declare` function, class, two-declarator `const`, `global`, and string-named and identifier-named `module` blocks keep `declare`, beside plain `namespace` and `module` blocks; block contents aren't listed.
== args
input/ambient-and-modules.ts
== file input/ambient-and-modules.ts
declare function ambientFn(x: string): number;
declare class AmbientThing {}
declare const ambientValue: string, ambientFlag: boolean;
declare global {
  interface Window { foo: string; }
}
declare module 'pkg' {
  export function make(): void;
}
declare module InternalPkg {
  export const ok: true;
}
namespace X {}
module Y {}
