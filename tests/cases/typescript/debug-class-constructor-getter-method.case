Debug mode highlights a class's constructor, getter, and method through their signatures, but not the `private value` field, which isn't a class member in the outline.
== args
--debug
input/debug-class-members.ts
== file input/debug-class-members.ts
class Counter {
  private value: number;
  constructor(initial: number) {
    this.value = initial;
  }
  get count() {
    return this.value;
  }
  increment(step: number): void {
    this.value += step;
  }
}
== stdout
«class Counter» {
  private value: number;
  «constructor(initial: number)» {
    this.value = initial;
  }
  «get count()» {
    return this.value;
  }
  «increment(step: number): void» {
    this.value += step;
  }
}
