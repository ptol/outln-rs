Debug mode highlights a `namespace` through its name and nothing inside it, not even a nested `export module Inner`.
== args
--debug
input/namespace.ts
== file input/namespace.ts
namespace PlainNamespace {
  export const enabled = true;
}

namespace NestedNamespace {
  export module Inner {
    export const value = 42;
  }
}
== stdout
«namespace PlainNamespace» {
  export const enabled = true;
}

«namespace NestedNamespace» {
  export module Inner {
    export const value = 42;
  }
}
== stderr
== exit 0
