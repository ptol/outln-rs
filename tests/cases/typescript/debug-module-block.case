Debug mode highlights a `module` block through its name and leaves the `export const` inside it plain, since only top-level declarations are listed.
== args
--debug
input/module.ts
== file input/module.ts
module PlainModule {
  export const mode = 'plain';
}

module StringLiteralModule {
  export const key = 'value';
}
== stdout
«module PlainModule» {
  export const mode = 'plain';
}

«module StringLiteralModule» {
  export const key = 'value';
}
== stderr
== exit 0
