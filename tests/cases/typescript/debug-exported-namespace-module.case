Debug mode highlights `export namespace` and `export module` blocks from `export` through their name, including a module named by the string `'exported/string-module'`.
== args
--debug
input/exported-namespace.ts
== file input/exported-namespace.ts
export namespace ExportedNamespace {
  export const ready = true;
}

export module ExportedModule {
  export const data = 'test';
}

export module 'exported/string-module' {}
== stdout
«export namespace ExportedNamespace» {
  export const ready = true;
}

«export module ExportedModule» {
