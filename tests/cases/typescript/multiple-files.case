Several file arguments print one outline each, in argument order, separated by a blank line.
== args
input/a.ts
input/b.ts
== file input/a.ts
interface A {
  value: number;
}
== file input/b.ts
export enum B {
  One = 1
}
== stdout
input/a.ts (3 lines)
[L1-L3] interface A

input/b.ts (3 lines)
[L1-L3] export enum B
== stderr
== exit 0
