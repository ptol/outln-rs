Debug mode highlights each of two adjacent classes and each one's method through its signature.
== args
--debug
input/multiple-classes.ts
== file input/multiple-classes.ts
class First {
  greet(): string {
    return "hello";
  }
}
class Second {
  farewell(): string {
    return "goodbye";
  }
}
== stdout
\x1b[32mclass First\x1b[0m {
  \x1b[32mgreet(): string\x1b[0m {
    return "hello";
  }
}
\x1b[32mclass Second\x1b[0m {
  \x1b[32mfarewell(): string\x1b[0m {
    return "goodbye";
  }
}
