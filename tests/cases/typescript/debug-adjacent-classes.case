Debug mode highlights each of two adjacent classes and each one's method through its signature.
== args
--debug
input/multiple-classes.ts
== file input/multiple-classes.ts
class First {
  greet(): string {
    return "hello";
  }
}
class Second {
  farewell(): string {
    return "goodbye";
  }
}
== stdout
«class First» {
  «greet(): string» {
    return "hello";
  }
}
«class Second» {
  «farewell(): string» {
    return "goodbye";
  }
}
== stderr
== exit 0
