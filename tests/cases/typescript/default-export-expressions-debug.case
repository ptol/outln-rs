Debug mode highlights a default-exported expression from `export` through what its line prints: the callee of a call, the opening brace of an object, or the `default` keyword for an expression printed as `…`.
== args
--debug
input/config.ts
== file input/config.ts
export default defineConfig({
  plugins: [],
});
export default {
  name: "x",
};
export default settings.production;
