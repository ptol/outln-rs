A class member's line range includes its decorators, like a class's, in both grammars: the TypeScript grammar parses member decorators as siblings of the member, the JavaScript grammar as part of it.
== args
input/controller.ts
input/controller.js
== file input/controller.ts
@Controller("users")
export class UserController {
  @Get(":id")
  @Auth()
  find(id: string): User {
    return lookup(id);
  }
}
== file input/controller.js
