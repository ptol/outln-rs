A UTF-8 byte order mark at the start of a file is stripped before any engine sees the text, so
the header comment, a JavaScript shebang, a Markdown heading, and the first key of a JSON object
are found on line 1 as without it.
== args
input/bom.md
input/bom.ts
input/bom.tsx
input/bom.js
input/bom.rs
input/bom.css
input/bom.json
input/bom.toml
input/bom.yaml
== file input/bom.md escaped
\xef\xbb\xbf# Title

## Section
== file input/bom.ts escaped
\xef\xbb\xbf// Header after a BOM.
export const a = 1;
== file input/bom.tsx escaped
\xef\xbb\xbf/** Header after a BOM. */
export function App() {}
== file input/bom.js escaped
\xef\xbb\xbf#!/usr/bin/env node
// Header after a BOM and a shebang.
function a() {}
== file input/bom.rs escaped
\xef\xbb\xbf//! Header after a BOM.
pub fn a() {}
== file input/bom.css escaped
\xef\xbb\xbf/* Header after a BOM. */
.a { color: red }
== file input/bom.json escaped
\xef\xbb\xbf{"name": "bom"}
== file input/bom.toml escaped
\xef\xbb\xbf# Header after a BOM.
name = "bom"
== file input/bom.yaml escaped
\xef\xbb\xbf# Header after a BOM.
name: bom
