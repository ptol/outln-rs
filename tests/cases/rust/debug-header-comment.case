Debug mode highlights the `//` header comment line along with the signatures `struct User` and `fn load(id: u64) -> User`, but not their bodies.
== args
--debug
input/sample.rs
== file input/sample.rs
// Domain model.

struct User {
  id: u64,
}

fn load(id: u64) -> User {
  User { id }
}
== stdout
«// Domain model.»

«struct User» {
  id: u64,
}

«fn load(id: u64) -> User» {
  User { id }
}
== stderr
== exit 0
