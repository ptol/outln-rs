root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[justfile]
indent_size = 4

# Casefiles are exact bytes, trailing whitespace included (tests/support/casefile.rs).
[tests/cases/**]
trim_trailing_whitespace = false
insert_final_newline = unset
